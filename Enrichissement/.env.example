# Port du serveur (3100 par défaut, distinct du mailer sur 3000)
PORT=3100
BASE_URL=http://localhost:3100

# Moteur de recherche pour la prospection. Priorité : Google CSE > Serper > Brave.
# Serper recommandé (gratuit jusqu'à 2500 requêtes) : https://serper.dev
SERPER_API_KEY=
# Optionnels :
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BRAVE_SEARCH_API_KEY=

# Extraction des champs prospect (nom, poste, entreprise, lieu) via Claude Haiku.
# Sans clé : repli sur le parsing heuristique (regex). Avec clé : extraction
# bien plus fiable + enrichissement de l'entreprise quand elle manque.
# Coût : ~quelques centimes pour un lot complet. https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle (par défaut claude-haiku-4-5) :
ANTHROPIC_MODEL=
