{
  "name": "enrichissement",
  "version": "0.1.0",
  "description": "Moteur de prospection B2B : recherche de personnes par poste au sein d'entreprises cibles (liste fournie ou base enrichie), via une API de recherche + extraction LLM.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "companies:seed": "tsx scripts/seed-companies.ts",
    "companies:domains": "tsx scripts/clean-company-domains.ts",
    "desktop:app": "bash scripts/macos-create-launcher.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
