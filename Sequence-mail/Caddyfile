# Caddy obtient et renouvelle le certificat HTTPS automatiquement pour ce domaine.
# Remplace le domaine si besoin.
go.rubysignal.com {
	encode gzip

	# --- Routes PUBLIQUES de suivi : ouvertes (le prospect ne doit pas s'authentifier) ---
	@public path /p/* /t/*
	handle @public {
		reverse_proxy app:3000
	}

	# --- Tout le reste (dashboard, /api, /auth) : protégé par mot de passe ---
	# Génère le hash avec :
	#   docker run --rm caddy:2 caddy hash-password --plaintext 'TON_MOT_DE_PASSE'
	# puis colle-le ci-dessous (utilisateur "admin").
	handle {
		basic_auth {
			admin REMPLACE_PAR_LE_HASH_BCRYPT
		}
		reverse_proxy app:3000
	}
}
